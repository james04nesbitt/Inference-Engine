# Bazel 9 compatibility: auto-load cc rules from rules_cc for deps
# that still use native cc_library in their BUILD files
common --incompatible_autoload_externally=cc_library,cc_binary,cc_test,cc_proto_library,cc_shared_library,cc_import

# =============================================================================
# Platform Specific Configs
# =============================================================================
build --enable_platform_specific_config
build --macos_minimum_os=14.0

# =============================================================================
# C++20 Standard & Native Optimizations
# =============================================================================
# Windows (MSVC)
build:windows --cxxopt=/std:c++20 --host_cxxopt=/std:c++20
build:windows --cxxopt=/arch:AVX2 --host_cxxopt=/arch:AVX2

# Linux (GCC/Clang)
build:linux --cxxopt=-std=c++20 --host_cxxopt=-std=c++20
build:linux --cxxopt=-march=native --host_cxxopt=-march=native

# macOS (Apple Clang)
build:macos --cxxopt=-std=c++20 --host_cxxopt=-std=c++20
build:macos --cxxopt=-march=native --host_cxxopt=-march=native

# =============================================================================
# Build Modes
# =============================================================================
build:release --compilation_mode=opt
build:debug --compilation_mode=dbg

test --test_output=errors

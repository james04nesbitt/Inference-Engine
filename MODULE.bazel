"""
Inference Engine - A from-scratch C++ inference engine for open-weight LLMs.
"""

module(
    name = "inference_engine",
    version = "0.1.0",
)

# C++ rules
bazel_dep(name = "rules_cc", version = "0.2.14")

# Google Test for unit testing
bazel_dep(name = "googletest", version = "1.17.0")

# Abseil - Google's C++ common libraries
bazel_dep(name = "abseil-cpp", version = "20250814.1", repo_name = "com_google_absl")

# Google Highway - Portable SIMD intrinsics (AVX2/AVX-512/NEON)
bazel_dep(name = "highway", version = "1.3.0")

# Google Benchmark - Microbenchmarking framework
# NOTE: Currently commented out — the BCR version depends on rules_foreign_cc
# which is incompatible with Bazel 9. Uncomment when BCR is updated.
